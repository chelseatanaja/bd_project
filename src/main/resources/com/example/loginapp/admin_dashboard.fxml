<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.loginapp.AdminDashboardController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color: #F1F5F9;">

    <!-- ========== SIDEBAR ========== -->
    <left>
        <VBox prefWidth="240" spacing="6"
              style="-fx-background-color: linear-gradient(to bottom, #07153A, #0B0F2F);">
            <padding><Insets top="28" right="14" bottom="28" left="14"/></padding>

            <!-- Logo -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="▣" textFill="#4F7CFF" style="-fx-font-size:30;"/>
                <VBox spacing="1">
                    <Label text="LMS Admin" textFill="WHITE">
                        <font><Font name="System Bold" size="18"/></font>
                    </Label>
                    <Label text="Management" textFill="#94A3B8" style="-fx-font-size:11;"/>
                </VBox>
            </HBox>

            <Separator opacity="0.2" style="-fx-padding:6 0;"/>

            <!-- Nav buttons -->
            <Button fx:id="btnNavDashboard" text="🏠   Dashboard"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color: linear-gradient(to right,#4F46E5,#2563EB);
                           -fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;
                           -fx-background-radius:12; -fx-alignment:CENTER_LEFT; -fx-cursor:hand;"
                    onAction="#handleNavDashboard"/>

            <Button fx:id="btnNavKelas" text="🖥   Manage Kelas"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:transparent; -fx-text-fill:#CBD5E1;
                           -fx-font-size:14; -fx-alignment:CENTER_LEFT; -fx-cursor:hand;
                           -fx-background-radius:12;"
                    onAction="#handleNavKelas"/>

            <Button fx:id="btnNavStudents" text="👥   Manage Students"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:transparent; -fx-text-fill:#CBD5E1;
                           -fx-font-size:14; -fx-alignment:CENTER_LEFT; -fx-cursor:hand;
                           -fx-background-radius:12;"
                    onAction="#handleNavStudents"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- DB Status -->
            <VBox spacing="6" style="-fx-background-color:rgba(255,255,255,0.07); -fx-background-radius:12; -fx-padding:14;">
                <Label text="● PostgreSQL" textFill="#4ADE80" style="-fx-font-size:13; -fx-font-weight:bold;"/>
                <Label text="Connected" textFill="#94A3B8" style="-fx-font-size:11;"/>
            </VBox>

            <!-- User info + Logout -->
            <VBox spacing="6" style="-fx-background-color:rgba(255,255,255,0.07); -fx-background-radius:12; -fx-padding:14;">
                <Label fx:id="lblSidebarNama" text="Admin" textFill="WHITE" style="-fx-font-weight:bold;"/>
                <Label fx:id="lblSidebarEmail" text="admin@lms.com" textFill="#94A3B8" style="-fx-font-size:11;"/>
                <Button text="Logout" maxWidth="Infinity" prefHeight="36"
                        style="-fx-background-color:#EF4444; -fx-text-fill:white;
                               -fx-background-radius:8; -fx-font-size:13; -fx-cursor:hand;"
                        onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ========== MAIN CONTENT ========== -->
    <center>
        <VBox spacing="0">
            <!-- Content Area switched by nav -->
            <StackPane VBox.vgrow="ALWAYS">

                <!-- DASHBOARD VIEW -->
                <VBox fx:id="viewDashboard" spacing="22" visible="true">
                    <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>

                    <VBox spacing="4">
                        <Label text="Academic Dashboard" textFill="#0F172A">
                            <font><Font name="System Bold" size="28"/></font>
                        </Label>
                        <Label text="Overview data akademik" textFill="#64748B"/>
                    </VBox>

                    <HBox spacing="18">
                        <VBox prefWidth="200" spacing="10"
                              style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:20;">
                            <Label text="Total Kelas" textFill="#64748B" style="-fx-font-size:13;"/>
                            <Label fx:id="lblTotalKelas" text="0" textFill="#0F172A">
                                <font><Font name="System Bold" size="32"/></font>
                            </Label>
                        </VBox>
                        <VBox prefWidth="200" spacing="10"
                              style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:20;">
                            <Label text="Total Students" textFill="#64748B" style="-fx-font-size:13;"/>
                            <Label fx:id="lblTotalUser" text="0" textFill="#0F172A">
                                <font><Font name="System Bold" size="32"/></font>
                            </Label>
                        </VBox>
                        <VBox prefWidth="200" spacing="10"
                              style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:20;">
                            <Label text="Total Assignment" textFill="#64748B" style="-fx-font-size:13;"/>
                            <Label fx:id="lblTotalAssignment" text="0" textFill="#0F172A">
                                <font><Font name="System Bold" size="32"/></font>
                            </Label>
                        </VBox>
                    </HBox>

                    <VBox spacing="14" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-background-radius:18; -fx-padding:22;">
                        <Label text="Recent Activity" textFill="#0F172A">
                            <font><Font name="System Bold" size="18"/></font>
                        </Label>
                        <TableView fx:id="tblRecent" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRecentId" text="ID" prefWidth="80"/>
                                <TableColumn fx:id="colRecentType" text="Tipe" prefWidth="120"/>
                                <TableColumn fx:id="colRecentName" text="Nama" prefWidth="300"/>
                                <TableColumn fx:id="colRecentStatus" text="Status" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- KELAS VIEW -->
                <VBox fx:id="viewKelas" spacing="16" visible="false">
                    <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>

                    <Label text="Manage Kelas" textFill="#0F172A">
                        <font><Font name="System Bold" size="26"/></font>
                    </Label>

                    <HBox spacing="18" VBox.vgrow="ALWAYS">
                        <!-- Form -->
                        <VBox spacing="12" prefWidth="280"
                              style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                            <Label text="Form Kelas" textFill="#334155" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="txtKelasId" promptText="ID Kelas" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            <TextField fx:id="txtKelasNama" promptText="Nama Kelas" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            <TextField fx:id="txtKelasKapasitas" promptText="Kapasitas" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            <TextField fx:id="txtKelasSemester" promptText="Semester" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            <Button fx:id="btnAddKelas" text="＋  Tambah" maxWidth="Infinity" prefHeight="42"
                                    style="-fx-background-color:#4F46E5; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                    onAction="#handleAddKelas"/>
                            <Button fx:id="btnEditKelas" text="✎  Edit" maxWidth="Infinity" prefHeight="42"
                                    style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                    onAction="#handleEditKelas"/>
                            <Button fx:id="btnDeleteKelas" text="🗑  Hapus" maxWidth="Infinity" prefHeight="42"
                                    style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                    onAction="#handleDeleteKelas"/>
                            <Button fx:id="btnClearKelas" text="⊗  Clear" maxWidth="Infinity" prefHeight="42"
                                    style="-fx-background-color:#E2E8F0; -fx-text-fill:#334155; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                    onAction="#handleClearKelas"/>
                        </VBox>

                        <!-- Table -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="Daftar Kelas" textFill="#0F172A" style="-fx-font-weight:bold; -fx-font-size:16;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtSearchKelas" promptText="Cari kelas..." prefWidth="220" prefHeight="38"
                                           style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            </HBox>
                            <TableView fx:id="tblKelas" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colKelasId" text="ID" prefWidth="80"/>
                                    <TableColumn fx:id="colKelasNama" text="Nama Kelas" prefWidth="220"/>
                                    <TableColumn fx:id="colKelasKapasitas" text="Kapasitas" prefWidth="120"/>
                                    <TableColumn fx:id="colKelasSemester" text="Semester" prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- STUDENTS VIEW -->
                <VBox fx:id="viewStudents" spacing="16" visible="false">
                    <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>

                    <Label text="Manage Students" textFill="#0F172A">
                        <font><Font name="System Bold" size="26"/></font>
                    </Label>

                    <HBox spacing="18" VBox.vgrow="ALWAYS">
                        <!-- Form -->
                        <VBox spacing="12" prefWidth="280"
                              style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                            <Label text="Form Student" textFill="#334155" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="txtStudentId" promptText="ID" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;" editable="false"/>
                            <TextField fx:id="txtStudentNama" promptText="Nama" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            <TextField fx:id="txtStudentEmail" promptText="Email" prefHeight="42"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            <Button fx:id="btnDeleteStudent" text="🗑  Hapus Student" maxWidth="Infinity" prefHeight="42"
                                    style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                    onAction="#handleDeleteStudent"/>
                            <Button fx:id="btnClearStudent" text="⊗  Clear" maxWidth="Infinity" prefHeight="42"
                                    style="-fx-background-color:#E2E8F0; -fx-text-fill:#334155; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                    onAction="#handleClearStudent"/>
                        </VBox>

                        <!-- Table -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="Daftar Students" textFill="#0F172A" style="-fx-font-weight:bold; -fx-font-size:16;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtSearchStudent" promptText="Cari student..." prefWidth="220" prefHeight="38"
                                           style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                            </HBox>
                            <TableView fx:id="tblStudents" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colStudentId" text="ID" prefWidth="60"/>
                                    <TableColumn fx:id="colStudentNama" text="Nama" prefWidth="200"/>
                                    <TableColumn fx:id="colStudentEmail" text="Email" prefWidth="260"/>
                                    <TableColumn fx:id="colStudentRole" text="Role" prefWidth="100"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </HBox>
                </VBox>

            </StackPane>
        </VBox>
    </center>

</BorderPane>
