<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<StackPane prefHeight="760" prefWidth="1280" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginapp.controller.SignUpController">

    <!-- BACKGROUND IMAGE (BLUR) -->
    <ImageView fitHeight="760" fitWidth="1280" preserveRatio="false" smooth="true">
        <image><Image url="@palace bg.jpg" /></image>
        <effect><BoxBlur height="18" iterations="3" width="18" /></effect>
    </ImageView>

    <!-- CONTENT -->
    <BorderPane prefHeight="760" prefWidth="1280" style="-fx-background-color: transparent;">

        <left>
            <VBox prefWidth="480" spacing="28" style="-fx-background-color: linear-gradient(to bottom, #F29BB9, #F29BB9, #E4568B);">
                <padding>
                    <Insets bottom="45" left="48" right="48" top="56" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <ImageView fitHeight="103.0" fitWidth="116.0" preserveRatio="true">
                        <image><Image url="@charm school logo.png" /></image>
                    </ImageView>
                    <VBox>
                        <Label prefHeight="53.0" prefWidth="270.0" text="Charm School" textFill="WHITE">
                            <font><Font name="CreatoDisplay-Black" size="39.0" /></font>
                        </Label>
                        <Label text="Learning Royal System" textFill="WHITE">
                            <font>
                                <Font name="CreatoDisplay-Regular" size="17.0" />
                            </font></Label>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="16">
                    <Label graphicTextGap="0.5" lineSpacing="0.5" prefHeight="0.0" prefWidth="346.0" text="Shaping Into" textFill="WHITE">
                        <font><Font name="CreatoDisplay-Black" size="42.0" /></font>
                    </Label>
                    <Label graphicTextGap="0.5" lineSpacing="0.5" prefHeight="0.0" prefWidth="346.0" text="Princess 👑" textFill="WHITE">
                        <font><Font name="CreatoDisplay-BlackItalic" size="42.0" /></font>
                    </Label>
                    <Label prefHeight="0.0" prefWidth="317.0" text="&quot;There's a princess in every girl.&quot;" textFill="WHITE" wrapText="true">
                        <font><Font size="17" /></font>
                    </Label>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </left>

        <center>
            <StackPane>
                <VBox alignment="CENTER" maxWidth="440" spacing="6" style="-fx-background-color:white; -fx-background-radius:28; -fx-padding:42;">

                    <Label text="🎀 Sign Up 🎀" textFill="#E4568B">
                        <font><Font name="System Bold" size="34" /></font>
                    </Label>

                    <Region prefHeight="12" />

                    <TextField fx:id="txtNama" prefHeight="48" prefWidth="320" promptText="Full Name" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10; -fx-padding:0 14;" />
                    <Label fx:id="lblNamaError" maxWidth="320" style="-fx-text-fill:#EF4444; -fx-font-size:11;" visible="false" wrapText="true" />

                    <TextField fx:id="txtEmail" prefHeight="48" prefWidth="320" promptText="Email" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10; -fx-padding:0 14;" />
                    <Label fx:id="lblEmailError" maxWidth="320" style="-fx-text-fill:#EF4444; -fx-font-size:11;" visible="false" wrapText="true" />

                    <PasswordField fx:id="txtPassword" prefHeight="48" prefWidth="320" promptText="Password" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10; -fx-padding:0 14;" />
                    <Label fx:id="lblPasswordError" maxWidth="320" style="-fx-text-fill:#EF4444; -fx-font-size:11;" visible="false" wrapText="true" />

                    <PasswordField fx:id="txtConfirmPassword" prefHeight="48" prefWidth="320" promptText="Confirm Password" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10; -fx-padding:0 14;" />
                    <Label fx:id="lblConfirmPasswordError" maxWidth="320" style="-fx-text-fill:#EF4444; -fx-font-size:11;" visible="false" wrapText="true" />

                    <ComboBox fx:id="cmbRole" prefHeight="48" prefWidth="320" promptText="Select Role" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10;" />
                    <Label fx:id="lblRoleError" maxWidth="320" style="-fx-text-fill:#EF4444; -fx-font-size:11;" visible="false" wrapText="true" />

                    <Region prefHeight="6" />

                    <Button fx:id="btnSignUp" prefHeight="52" prefWidth="320" style="-fx-background-color: linear-gradient(to right, #E4568B, #E4568B);                                -fx-text-fill:white;                                -fx-font-weight:bold;                                -fx-font-size:15;                                -fx-background-radius:15;                                -fx-cursor:hand;" text="SIGN UP" />

                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?" />
                        <Hyperlink fx:id="btnLogin" text="Login" textFill="#E4568B" />
                    </HBox>

                </VBox>
            </StackPane>
        </center>

    </BorderPane>
</StackPane>
