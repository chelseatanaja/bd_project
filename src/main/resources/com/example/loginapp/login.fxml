<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="760" prefWidth="1280" style="-fx-background-color: linear-gradient(to bottom right, #F4F7FF, #EEF3FF);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginapp.LoginController">

    <left>
        <VBox prefWidth="480" spacing="28" style="-fx-background-color: linear-gradient(to bottom, #07153A, #0B0F2F);">
            <padding>
                <Insets bottom="45" left="48" right="48" top="56" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="64" fitWidth="64" preserveRatio="true">
                    <image>
                        <Image url="@CHARM_SCHOOL.png" />
                    </image>
                </ImageView>
                <VBox>
                    <Label text="Charm School" textFill="WHITE">
                        <font><Font name="System Bold" size="42" /></font>
                    </Label>
                    <Label text="Learning Management System" textFill="#CBD5E1" />
                </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="16">
                <Label text="Welcome Back" textFill="WHITE">
                    <font><Font name="System Bold" size="42" /></font>
                </Label>
                <Label text="Fresh start, where your bright future begins!" textFill="#CBD5E1" wrapText="true">
                    <font><Font size="17" /></font>
                </Label>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <StackPane>
            <VBox alignment="CENTER" maxWidth="440" spacing="10" style="-fx-background-color:white; -fx-background-radius:28; -fx-padding:48;">

                <Label text="Login" textFill="#0F172A">
                    <font><Font name="System Bold" size="34" /></font>
                </Label>

                <!-- Email -->
                <TextField fx:id="txtEmail" prefHeight="50" prefWidth="340" promptText="Email" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10; -fx-padding:0 14;" />
                <Label fx:id="lblEmailError" prefWidth="340" style="-fx-font-size:12;" textFill="#EF4444" />

                <!-- Password -->
                <PasswordField fx:id="txtPassword" prefHeight="50" prefWidth="340" promptText="Password" style="-fx-background-radius:10; -fx-border-color:#E2E8F0; -fx-border-radius:10; -fx-padding:0 14;" />
                <Label fx:id="lblPasswordError" prefWidth="340" style="-fx-font-size:12;" textFill="#EF4444" />

                <Region prefHeight="8" />

                <Button fx:id="btnLogin" prefHeight="52" prefWidth="340" style="-fx-background-color: linear-gradient(to right, #4F46E5, #2563EB);                                -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:15;                                -fx-background-radius:15; -fx-cursor:hand;" text="LOGIN" />

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Don't have an account?" />
                    <Hyperlink fx:id="btnSignUp" text="Sign Up" />
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
