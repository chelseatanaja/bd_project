<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.loginapp.controller.DosenDashboardController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color: #F1F5F9;">

    <!-- ========== SIDEBAR ========== -->
    <left>
        <VBox prefWidth="240" spacing="6"
              style="-fx-background-color: linear-gradient(to bottom, #07153A, #0B0F2F);">
            <padding><Insets top="28" right="14" bottom="28" left="14"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="▣" textFill="#4F7CFF" style="-fx-font-size:30;"/>
                <VBox spacing="1">
                    <Label text="LMS Dosen" textFill="WHITE">
                        <font><Font name="System Bold" size="18"/></font>
                    </Label>
                    <Label text="Pengajar" textFill="#94A3B8" style="-fx-font-size:11;"/>
                </VBox>
            </HBox>

            <Separator opacity="0.2"/>

            <Button fx:id="btnNavDashboard" text="🏠   Dashboard"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:linear-gradient(to right,#4F46E5,#2563EB);
                           -fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;
                           -fx-background-radius:12; -fx-alignment:CENTER_LEFT; -fx-cursor:hand;"
                    onAction="#handleNavDashboard"/>

            <Button fx:id="btnNavTugas" text="📋   Manage Tugas"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:transparent; -fx-text-fill:#CBD5E1;
                           -fx-font-size:14; -fx-alignment:CENTER_LEFT; -fx-cursor:hand; -fx-background-radius:12;"
                    onAction="#handleNavTugas"/>

            <Button fx:id="btnNavMateri" text="📚   Manage Materi"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:transparent; -fx-text-fill:#CBD5E1;
                           -fx-font-size:14; -fx-alignment:CENTER_LEFT; -fx-cursor:hand; -fx-background-radius:12;"
                    onAction="#handleNavMateri"/>

            <Button fx:id="btnNavSubmission" text="📥   Submission Masuk"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:transparent; -fx-text-fill:#CBD5E1;
                           -fx-font-size:14; -fx-alignment:CENTER_LEFT; -fx-cursor:hand; -fx-background-radius:12;"
                    onAction="#handleNavSubmission"/>

            <Button fx:id="btnNavPengumuman" text="📢   Pengumuman"
                    maxWidth="Infinity" prefHeight="46"
                    style="-fx-background-color:transparent; -fx-text-fill:#CBD5E1;
                           -fx-font-size:14; -fx-alignment:CENTER_LEFT; -fx-cursor:hand; -fx-background-radius:12;"
                    onAction="#handleNavPengumuman"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="6" style="-fx-background-color:rgba(255,255,255,0.07); -fx-background-radius:12; -fx-padding:14;">
                <Label fx:id="lblSidebarNama" text="Dosen" textFill="WHITE" style="-fx-font-weight:bold;"/>
                <Label fx:id="lblSidebarEmail" text="" textFill="#94A3B8" style="-fx-font-size:11;"/>
                <Button text="Logout" maxWidth="Infinity" prefHeight="36"
                        style="-fx-background-color:#EF4444; -fx-text-fill:white;
                               -fx-background-radius:8; -fx-font-size:13; -fx-cursor:hand;"
                        onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ========== MAIN CONTENT ========== -->
    <center>
        <StackPane>

            <!-- DASHBOARD VIEW -->
            <VBox fx:id="viewDashboard" spacing="22" visible="true">
                <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
                <VBox spacing="4">
                    <Label text="Dashboard Dosen" textFill="#0F172A">
                        <font><Font name="System Bold" size="28"/></font>
                    </Label>
                    <Label text="Selamat datang!" textFill="#64748B"/>
                </VBox>
                <HBox spacing="18">
                    <VBox prefWidth="190" spacing="10" style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;">
                        <Label text="Total Tugas" textFill="#64748B" style="-fx-font-size:13;"/>
                        <Label fx:id="lblTotalAssignment" text="0" textFill="#0F172A">
                            <font><Font name="System Bold" size="30"/></font>
                        </Label>
                    </VBox>
                    <VBox prefWidth="190" spacing="10" style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;">
                        <Label text="Total Materi" textFill="#64748B" style="-fx-font-size:13;"/>
                        <Label fx:id="lblTotalMateri" text="0" textFill="#0F172A">
                            <font><Font name="System Bold" size="30"/></font>
                        </Label>
                    </VBox>
                    <VBox prefWidth="190" spacing="10" style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;">
                        <Label text="Submission Masuk" textFill="#64748B" style="-fx-font-size:13;"/>
                        <Label fx:id="lblTotalSubmission" text="0" textFill="#0F172A">
                            <font><Font name="System Bold" size="30"/></font>
                        </Label>
                    </VBox>
                    <VBox prefWidth="190" spacing="10" style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:18;">
                        <Label text="Pengumuman" textFill="#64748B" style="-fx-font-size:13;"/>
                        <Label fx:id="lblTotalPengumuman" text="0" textFill="#0F172A">
                            <font><Font name="System Bold" size="30"/></font>
                        </Label>
                    </VBox>
                </HBox>
                <!-- Recent assignments table -->
                <VBox spacing="12" VBox.vgrow="ALWAYS" style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                    <Label text="Tugas Terbaru" textFill="#0F172A" style="-fx-font-weight:bold; -fx-font-size:16;"/>
                    <TableView fx:id="tblDashboard" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colDashId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colDashJudul" text="Judul Tugas" prefWidth="280"/>
                            <TableColumn fx:id="colDashKelas" text="Kelas" prefWidth="180"/>
                            <TableColumn fx:id="colDashDeadline" text="Deadline" prefWidth="160"/>
                        </columns>
                        <placeholder><Label text="Belum ada tugas." textFill="#94A3B8"/></placeholder>
                    </TableView>
                </VBox>
            </VBox>

            <!-- TUGAS VIEW -->
            <VBox fx:id="viewTugas" spacing="16" visible="false">
                <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
                <Label text="Manage Tugas" textFill="#0F172A">
                    <font><Font name="System Bold" size="26"/></font>
                </Label>
                <HBox spacing="18" VBox.vgrow="ALWAYS">
                    <!-- Form -->
                    <VBox spacing="12" prefWidth="290"
                          style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Form Tugas" textFill="#334155" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="txtTugasJudul" promptText="Judul Tugas" prefHeight="42"
                                   style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                        <TextArea fx:id="txtTugasDeskripsi" promptText="Deskripsi tugas..." prefHeight="80" wrapText="true"
                                  style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:8;"/>
                        <ComboBox fx:id="cmbTugasKelas" promptText="Pilih Kelas" maxWidth="Infinity" prefHeight="42"/>
                        <DatePicker fx:id="dpTugasDeadline" promptText="Deadline" maxWidth="Infinity" prefHeight="42"/>
                        <Button text="＋  Tambah Tugas" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#4F46E5; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleTambahTugas"/>
                        <Button text="✎  Update Tugas" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleEditTugas"/>
                        <Button text="🗑  Hapus Tugas" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleHapusTugas"/>
                        <Button text="⊗  Clear" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#E2E8F0; -fx-text-fill:#334155; -fx-background-radius:8; -fx-cursor:hand;"
                                onAction="#handleClearTugas"/>
                    </VBox>
                    <!-- Table -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Daftar Tugas" textFill="#0F172A" style="-fx-font-weight:bold; -fx-font-size:16;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtSearchTugas" promptText="Cari tugas..." prefWidth="200" prefHeight="38"
                                       style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                        </HBox>
                        <TableView fx:id="tblTugas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTugasId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colTugasJudul" text="Judul" prefWidth="240"/>
                                <TableColumn fx:id="colTugasKelas" text="Kelas" prefWidth="160"/>
                                <TableColumn fx:id="colTugasDeadline" text="Deadline" prefWidth="140"/>
                            </columns>
                            <placeholder><Label text="Belum ada tugas." textFill="#94A3B8"/></placeholder>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>

            <!-- MATERI VIEW -->
            <VBox fx:id="viewMateri" spacing="16" visible="false">
                <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
                <Label text="Manage Materi" textFill="#0F172A">
                    <font><Font name="System Bold" size="26"/></font>
                </Label>
                <HBox spacing="18" VBox.vgrow="ALWAYS">
                    <VBox spacing="12" prefWidth="290"
                          style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Form Materi" textFill="#334155" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="txtMateriJudul" promptText="Judul Materi" prefHeight="42"
                                   style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                        <TextArea fx:id="txtMateriIsi" promptText="Isi materi / link file..." prefHeight="100" wrapText="true"
                                  style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:8;"/>
                        <ComboBox fx:id="cmbMateriKelas" promptText="Pilih Kelas" maxWidth="Infinity" prefHeight="42"/>
                        <Button text="＋  Tambah Materi" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#4F46E5; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleTambahMateri"/>
                        <Button text="🗑  Hapus Materi" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleHapusMateri"/>
                        <Button text="⊗  Clear" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#E2E8F0; -fx-text-fill:#334155; -fx-background-radius:8; -fx-cursor:hand;"
                                onAction="#handleClearMateri"/>
                    </VBox>
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Daftar Materi" textFill="#0F172A" style="-fx-font-weight:bold; -fx-font-size:16;"/>
                        <TableView fx:id="tblMateri" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colMateriId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colMateriJudul" text="Judul" prefWidth="220"/>
                                <TableColumn fx:id="colMateriKelas" text="Kelas" prefWidth="160"/>
                                <TableColumn fx:id="colMateriIsi" text="Isi / Link" prefWidth="240"/>
                            </columns>
                            <placeholder><Label text="Belum ada materi." textFill="#94A3B8"/></placeholder>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>

            <!-- SUBMISSION VIEW -->
            <VBox fx:id="viewSubmission" spacing="16" visible="false">
                <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
                <Label text="Submission Masuk" textFill="#0F172A">
                    <font><Font name="System Bold" size="26"/></font>
                </Label>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearchSubmission" promptText="Cari submission..." prefWidth="240" prefHeight="40"
                               style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✎  Beri Nilai" prefHeight="40"
                            style="-fx-background-color:#4F46E5; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                            onAction="#handleBeriNilai"/>
                </HBox>
                <TableView fx:id="tblSubmission" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:white; -fx-background-radius:16;">
                    <columns>
                        <TableColumn fx:id="colSubId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colSubNamaMhs" text="Nama Mahasiswa" prefWidth="200"/>
                        <TableColumn fx:id="colSubTugas" text="Tugas" prefWidth="200"/>
                        <TableColumn fx:id="colSubKelas" text="Kelas" prefWidth="150"/>
                        <TableColumn fx:id="colSubTanggal" text="Tgl Kumpul" prefWidth="140"/>
                        <TableColumn fx:id="colSubFile" text="File" prefWidth="180"/>
                        <TableColumn fx:id="colSubNilai" text="Nilai" prefWidth="80"/>
                    </columns>
                    <placeholder><Label text="Belum ada submission." textFill="#94A3B8"/></placeholder>
                </TableView>
            </VBox>

            <!-- PENGUMUMAN VIEW -->
            <VBox fx:id="viewPengumuman" spacing="16" visible="false">
                <padding><Insets top="30" right="32" bottom="30" left="32"/></padding>
                <Label text="Pengumuman" textFill="#0F172A">
                    <font><Font name="System Bold" size="26"/></font>
                </Label>
                <HBox spacing="18" VBox.vgrow="ALWAYS">
                    <VBox spacing="12" prefWidth="310"
                          style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Buat Pengumuman" textFill="#334155" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="txtPengumumanJudul" promptText="Judul pengumuman" prefHeight="42"
                                   style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:0 12;"/>
                        <TextArea fx:id="txtPengumumanIsi" promptText="Isi pengumuman (misal: Ulangan Tengah Semester pada Senin 7 Juli 2026, jam 08.00, di Gedung A Ruang 301)"
                                  prefHeight="140" wrapText="true"
                                  style="-fx-background-radius:8; -fx-border-color:#E2E8F0; -fx-border-radius:8; -fx-padding:8;"/>
                        <ComboBox fx:id="cmbPengumumanKelas" promptText="Target Kelas (opsional)" maxWidth="Infinity" prefHeight="42"/>
                        <Button text="📢  Kirim Pengumuman" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#4F46E5; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleKirimPengumuman"/>
                        <Button text="🗑  Hapus" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;"
                                onAction="#handleHapusPengumuman"/>
                        <Button text="⊗  Clear" maxWidth="Infinity" prefHeight="42"
                                style="-fx-background-color:#E2E8F0; -fx-text-fill:#334155; -fx-background-radius:8; -fx-cursor:hand;"
                                onAction="#handleClearPengumuman"/>
                    </VBox>
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Daftar Pengumuman" textFill="#0F172A" style="-fx-font-weight:bold; -fx-font-size:16;"/>
                        <TableView fx:id="tblPengumuman" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colPengId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colPengJudul" text="Judul" prefWidth="200"/>
                                <TableColumn fx:id="colPengIsi" text="Isi" prefWidth="300"/>
                                <TableColumn fx:id="colPengKelas" text="Kelas" prefWidth="140"/>
                                <TableColumn fx:id="colPengTgl" text="Tanggal" prefWidth="140"/>
                            </columns>
                            <placeholder><Label text="Belum ada pengumuman." textFill="#94A3B8"/></placeholder>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
